{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudops.local/schemas/request-options.schema.json",
  "title": "Opções do formulário de solicitação cloudOps",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultEnvironment", "defaultRegion", "accountNames", "regions", "environments"],
  "properties": {
    "$schema": { "type": "string" },
    "defaultEnvironment": { "type": "string", "minLength": 1 },
    "defaultRegion": { "type": "string", "minLength": 1 },
    "accountNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}