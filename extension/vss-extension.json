{
  "manifestVersion": 1,
  "id": "cloudHub",
  "version": "1.0.6",
  "name": "CloudHub",
  "description": "Formul\u00e1rios din\u00e2micos que podem iniciar pipelines autorizadas.",
  "publisher": "cloudops2",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "scopes": [
    "vso.profile",
    "vso.project",
    "vso.code",
    "vso.build_execute",
    "vso.extension.data",
    "vso.extension.data_write"
  ],
  "contributions": [
    {
      "id": "smart-forms-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-build-web.build-release-hub-group"
      ],
      "properties": {
        "name": "CloudHub",
        "order": 90,
        "uri": "dist/index.html"
      }
    },
    {
      "id": "smart-forms-settings",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-web.collection-admin-hub-group"
      ],
      "properties": {
        "name": "CloudHub",
        "order": 90,
        "uri": "dist/index.html?view=admin"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ]
}
